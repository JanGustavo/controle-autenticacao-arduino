{$ARDLOCK_DOMAIN:ardlock.jangustavo.me} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /ws/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}

http://localhost, http://127.0.0.1 {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /ws/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
